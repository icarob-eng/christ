entity Adder_16b is
	port(
		a, b: in bit_vector(15 downto 0);
		cin: in bit;
		flags: out bit_vector(3 downto 0);
		r: out bit_vector(15 downto 0)
	);
end;

architecture behav of Adder_16b is

	component Full_Adder is
		port(
			a, b, cin: in bit;
			cout, s: out bit
		);
	end component;
	
	component Flags_Calculator is
		port(
			s: in bit_vector(15 downto 0);
			a_15, cout_15, cout_14: in bit;
			flags: out bit_vector(2 downto 0)
		);
	end component;
	
	signal COUTS: bit_vector(15 downto 0); -- stores full adders couts
	
	signal S_ADDERS: bit_vector(15 downto 0); -- stores adders results
	
begin
	full_adder15: Full_Adder port map(a => a(15), b => b(15), cin => COUTS(14), s => S_ADDERS(15), cout => COUTS(15));
	full_adder14: Full_Adder port map(a => a(14), b => b(14), cin => COUTS(13), s => S_ADDERS(14), cout => COUTS(14));
	full_adder13: Full_Adder port map(a => a(13), b => b(13), cin => COUTS(12), s => S_ADDERS(13), cout => COUTS(13));
	full_adder12: Full_Adder port map(a => a(12), b => b(12), cin => COUTS(11), s => S_ADDERS(12), cout => COUTS(12));
	full_adder11: Full_Adder port map(a => a(11), b => b(11), cin => COUTS(10), s => S_ADDERS(11), cout => COUTS(11));
	full_adder10: Full_Adder port map(a => a(10), b => b(10), cin => COUTS(9), s => S_ADDERS(10), cout => COUTS(10));
	full_adder9: Full_Adder port map(a => a(9), b => b(9), cin => COUTS(8), s => S_ADDERS(9), cout => COUTS(9));
	full_adder8: Full_Adder port map(a => a(8), b => b(8), cin => COUTS(7), s => S_ADDERS(8), cout => COUTS(8));
	full_adder7: Full_Adder port map(a => a(7), b => b(7), cin => COUTS(6), s => S_ADDERS(7), cout => COUTS(7));
	full_adder6: Full_Adder port map(a => a(6), b => b(6), cin => COUTS(5), s => S_ADDERS(6), cout => COUTS(6));
	full_adder5: Full_Adder port map(a => a(5), b => b(5), cin => COUTS(4), s => S_ADDERS(5), cout => COUTS(5));
	full_adder4: Full_Ader port map(a => a(4), b => b(4), cin => COUTS(3), s => S_ADDERS(4), cout => COUTS(4));
	full_adder3: Full_Adder port map(a => a(3), b => b(3), cin => COUTS(2), s => S_ADDERS(3), cout => COUTS(3));
	full_adder2: Full_Adder port map(a => a(2), b => b(2), cin => COUTS(1), s => S_ADDERS(2), cout => COUTS(2));
	full_adder1: Full_Adder port map(a => a(1), b => b(1), cin => COUTS(0), s => S_ADDERS(1), cout => COUTS(1));
	full_adder0: Full_Adder port map(a => a(0), b => b(0), cin => cin, s => S_ADDERS(0), cout => COUTS(0));
	
	flag_calculator0: Flags_Calculator port map(s => S_ADDERS, a_15 => a(15), cout_15 => COUTS(15), cout_14 => COUTS(14), flags => flags);
	
	r <= S_ADDERS;
end;
