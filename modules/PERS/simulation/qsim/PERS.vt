module PERS_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [2:0] addr;
reg [15:0] bus_in;
reg clk;
reg [15:0] ext_in_buttons;
reg [15:0] ext_in_switches;
reg r_en;
reg w_en;
// wires                                               
wire [15:0] bus_out;
wire [6:0] ext_out_7seg_0;
wire [6:0] ext_out_7seg_1;
wire [6:0] ext_out_7seg_2;
wire [6:0] ext_out_7seg_3;
wire [15:0] ext_out_leds;

wire sampler;                             

// assign statements (if any)                          
PERS i1 (
// port map - connection between master ports and signals/registers   
	.addr(addr),
	.bus_in(bus_in),
	.bus_out(bus_out),
	.clk(clk),
	.ext_in_buttons(ext_in_buttons),
	.ext_in_switches(ext_in_switches),
	.ext_out_7seg_0(ext_out_7seg_0),
	.ext_out_7seg_1(ext_out_7seg_1),
	.ext_out_7seg_2(ext_out_7seg_2),
	.ext_out_7seg_3(ext_out_7seg_3),
	.ext_out_leds(ext_out_leds),
	.r_en(r_en),
	.w_en(w_en)
);

// clk
initial
begin
	repeat(16)
	begin
		clk = 1'b0;
		clk = #30000 1'b1;
		# 30000;
	end
	clk = 1'b0;
	clk = #30000 1'b1;
end 
// addr[ 2 ]
initial
begin
	addr[2] = 1'b0;
end 
// addr[ 1 ]
initial
begin
	addr[1] = 1'b0;
end 
// addr[ 0 ]
initial
begin
